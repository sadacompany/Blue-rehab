# Optional local overrides. Netlify production values are configured in netlify.toml.

# Client
VITE_API_URL=http://localhost:4000/api
VITE_SUPABASE_URL=https://lfuuptigzjocgewhrmkt.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_578u_Ab3cgUlqcXhFiidnQ_MnoAEf9l

# Local Node.js API
PORT=4000
CLIENT_URL=http://localhost:5173
SUPABASE_URL=https://lfuuptigzjocgewhrmkt.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_578u_Ab3cgUlqcXhFiidnQ_MnoAEf9l

# No service-role key is required for the deployed API.
# Authenticated writes use the user's JWT and Supabase RLS.

# Google Meet for remote sessions (free — uses the Google Calendar API).
# Leave blank to disable: bookings still work, just without an auto-generated link.
# Setup guide: docs/google-meet.md. These are SECRETS — set them in the Netlify
# UI (Site settings → Environment variables), never in netlify.toml.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_MEET_TIME_ZONE=Asia/Riyadh

# --- One-time password (OTP) -------------------------------------------------
# mock = fixed on-screen code, no SMS provider needed (pre-launch only).
# sms  = real Supabase phone OTP; requires a paid SMS provider.
# The mock is NOT a security boundary — switch to `sms` before real patients use
# the platform. See docs/otp-mock.md.
VITE_AUTH_MODE=mock
VITE_MOCK_OTP_CODE=123456
VITE_MOCK_OTP_SECRET=change-me-in-your-environment

# --- Moyasar payments --------------------------------------------------------
# Use the TEST pair (pk_test_… / sk_test_…) from the Moyasar dashboard while
# testing; live keys charge real cards. These are SECRETS: set them in the
# Netlify UI (Site settings → Environment variables), never in netlify.toml
# and never committed. See docs/payments-moyasar.md.
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=

# Origin used to build the payment callback URL.
PUBLIC_SITE_URL=http://localhost:5173

# Required to record a verified payment result (users must not be able to mark
# their own payment as paid). Supabase → Project settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=
