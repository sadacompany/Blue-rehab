{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  "include": [
    "functions/**/*.ts",
    "../api/**/*.ts",
    "../server/src/fetch-handler.ts",
    "../server/src/runtime-api.ts",
    "../server/src/google-meet.ts",
    "../server/src/moyasar.ts",
    "../server/src/config.ts",
    "../server/src/supabase.ts"
  ]
}
