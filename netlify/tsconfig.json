  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  "include": [
    "functions/**/*.ts",
    "../server/src/api.ts",
    "../server/src/catalog.ts",
    "../server/src/config.ts",
    "../server/src/supabase.ts"
  ]
}
